<?xml version="1.0" encoding="utf-8"?>
<!--
    The white launcher icon, for the personalization page's second choice.

    Same three layers as `ic_launcher.xml` and only the field and the ink differ:
    the white background colour, the black-cut foreground, and the themed-icon
    layer that both icons share because the system recolours it either way.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background_light" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_light" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>

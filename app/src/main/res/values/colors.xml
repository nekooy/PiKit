<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window the system draws before Compose's first frame, matched to the
        theme's dark `surface` (`PiColor.kt`, `PiDarkScheme`). The launcher icon is
        black with a white mark, so the window that appears before Compose draws
        matches the icon instead of flashing a lighter grey — and it now also
        matches what Compose is about to paint, which is what removes the last
        visible step between the system's splash and the app.
    -->
    <color name="pikit_window_background">#FF131218</color>
    <!--
        The black field of the launcher icon that `LauncherIcon.DARK` selects:
        white wordmark on black. It is not the default; the white field below is
        the one a fresh install shows. The window the system puts up before the
        app runs stays dark because it matches the runtime's own surface, which
        nothing at run time has been able to consult yet.
    -->
    <color name="ic_launcher_background">#FF000000</color>
    <!--
        The white field of the default launcher icon (`LauncherIcon.DEFAULT`),
        with `ic_launcher_foreground_light`'s black wordmark on it. Plain white
        rather than a near-white, because this is the whole of what "on white"
        means on a home screen; the black icon is the other choice in the
        personalization page.
    -->
    <color name="ic_launcher_background_light">#FFFFFFFF</color>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
    "Back to the latest message": Lucide's `arrow-down`.

    The jump-to-latest control used to carry the library's `ExpandMore` — a chevron,
    which is the *disclosure* figure on this page: the same glyph opens a tool's output
    and a turn's folded steps. A control that scrolls a list is not a disclosure, and
    the two marks sat within a screen of each other on the same page. An arrow is the
    figure every chat app puts on that button (the thread scrolls *down* to its end),
    and it is distinguishable from the chevrons at 20dp without reading the label.

    Provenance: Lucide (ISC), 24-unit grid, stroke 2 of 24, round caps — the family
    `ic_check.xml`, `ic_copy.xml` and `ic_arrow_up.xml` are drawn in:

        M12 5v14 m19 12-7 7-7-7

    Source: https://github.com/lucide-icons/lucide
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M12 5 L12 19 M5 12 L12 19 L19 12"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>

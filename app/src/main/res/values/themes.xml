<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        No AppCompat/Material dependency is pulled in, so the window theme is
        built on the platform Material theme. Compose draws everything else.
    -->
    <style name="Theme.PiKit" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pikit_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>

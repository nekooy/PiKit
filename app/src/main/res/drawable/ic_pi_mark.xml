<?xml version="1.0" encoding="utf-8"?>
<!--
    PiKit's compact mark: the P from the launcher's pixel wordmark, for in-app use
    wherever one figure has to stay legible.

    The path is the wordmark's first letter, translated to its own tight bounding
    box and nothing else: three cells wide by four high at the wordmark's 4.2-unit
    cell, so the notch, the bowl and the pixel edge keep the approved geometry
    rather than being redrawn at a smaller scale. The full wordmark is thirteen
    cells wide and cannot survive the 28-34dp avatar or the 56dp setup mark; the
    launcher foreground remains the one place the whole name is drawn.

    **White, like the launcher icon.** It was amber until the first-launch screen was
    looked at next to the icon it comes from: the tap and the screen it opens are the
    same moment, and a mark that changes colour between them reads as a different
    logo. The amber goes on the surface it is actually for — `Icons.Filled.*` tints
    and the interface's own accents — not on the logo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="12.6dp"
    android:height="16.8dp"
    android:viewportWidth="12.6"
    android:viewportHeight="16.8">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M0,0 L0,16.8 L4.2,16.8 L4.2,12.6 L8.4,12.6 L8.4,8.4 L12.6,8.4 L12.6,0 Z M8.4,8.4 L4.2,8.4 L4.2,4.2 L8.4,4.2 Z" />
</vector>

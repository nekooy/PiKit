<?xml version="1.0" encoding="utf-8"?>
<!--
    The themed-icon layer: the same Pi mark with a single flat colour, because the
    system replaces it with one of its own.

    Since the foreground became white on black, this layer and the ordinary
    foreground are the same picture rather than two — kept as a separate file
    anyway, because the system is allowed to recolour this one and must never
    recolour that one.

    The translation matches ic_launcher_foreground: the mark's bounding box is
    asymmetric, so it has to be moved onto the viewport centre (54, 54) rather
    than drawn where its raw coordinates land. See that file for the arithmetic.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:translateX="5.3" android:translateY="-4.8">
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M29.9,40 L58.1,40 L58.1,58.8 L48.7,58.8 L48.7,68.2 L39.3,68.2 L39.3,77.6 L29.9,77.6 Z M39.3,49.4 L39.3,58.8 L48.7,58.8 L48.7,49.4 Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M58.1,58.8 L67.5,58.8 L67.5,77.6 L58.1,77.6 Z" />
    </group>
</vector>

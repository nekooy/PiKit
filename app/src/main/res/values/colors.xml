<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window the system draws before Compose's first frame, matched to the
        theme's dark `surface` (`PiColor.kt`, `PiDarkScheme`). The launcher icon is
        black with a white mark, so the window that appears before Compose draws
        matches the icon instead of flashing a lighter grey — and it now also
        matches what Compose is about to paint, which is what removes the last
        visible step between the system's splash and the app.
    -->
    <color name="pikit_window_background">#FF131218</color>
    <!--
        The launcher icon's field: black with the white mark on it, which is what
        the icon the *default* is — the white one is a choice made from inside the
        app, and the window the system puts up before the app runs is drawn from
        this theme, which nothing at run time has been able to consult yet.
    -->
    <color name="ic_launcher_background">#FF000000</color>
    <!--
        The other face of that icon: the field the personalization page's second
        choice paints behind the mark, with `ic_launcher_foreground_light`'s black
        ink on it. Plain white rather than a near-white, because this is the whole
        of what "on white" means on a home screen.
    -->
    <color name="ic_launcher_background_light">#FFFFFFFF</color>
</resources>
